# Local TLS rehearsal. Copy to .env; never commit .env or secret files.
DOMAIN=localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
IMAGE_TAG=local
TLS_DIRECTORY=./deploy/tls
MODELS_DIRECTORY=./deploy/models
# Optional trained model only: /models/manifest.json
VISION_MANIFEST_PATH=
# Change subnet and proxy address together if this subnet conflicts with the host network.
NETWORK_SUBNET=172.30.85.0/24
PROXY_IP=172.30.85.2
# Optional compose.admin.yaml needs ADMIN_EMAIL and ADMIN_PASSWORD_FILE.
