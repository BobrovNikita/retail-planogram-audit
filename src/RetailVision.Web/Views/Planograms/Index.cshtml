@model IReadOnlyList<RetailVision.Core.Planogram>
@{ ViewData["Title"] = "Планограммы"; var admin = User.IsInRole("Administrator"); }
<div class="page-heading"><div><p class="eyebrow">ЭТАЛОН ВЫКЛАДКИ</p><h1>Планограммы</h1><p class="subheading">Товары, полки и последовательность — единый источник правил для проверки.</p></div>
@if (admin) { <div class="plan-actions"><a class="button" asp-action="Import">Импорт JSON</a><a class="button primary" asp-action="Create">+ Создать</a></div> }
else { <a class="button" href="/account/login">Войти для редактирования</a> }</div>
@if (Model.Count == 0) { <section class="panel empty-state"><h2>Пока нет планограмм</h2><p>Администратор может создать первую схему выкладки.</p></section> }
@foreach (var plan in Model)
{
    <section class="panel planogram"><div class="panel-heading"><div><h2>@plan.Name</h2><p class="muted">@plan.Store · Версия @plan.Version</p></div><span class="badge mint">@plan.Shelves.Count полок · @plan.Shelves.Sum(s => s.Slots.Sum(p => p.Facings)) фейсингов</span></div>
    @foreach (var shelf in plan.Shelves.OrderBy(s => s.Number))
    { <div class="shelf-row"><span class="shelf-number">ПОЛКА @shelf.Number</span><div class="shelf-products">@foreach (var slot in shelf.Slots.OrderBy(s => s.Position)) { @for (var i = 0; i < slot.Facings; i++) { <div class="shelf-product"><partial name="_Product" model="slot.Product" /><span>@slot.Product.Name</span><small>@slot.Product.Sku @(!slot.Product.IsActive ? "· Неактивен" : "")</small></div> } }</div></div> }
    <div class="planogram-footer"><span class="muted">@plan.Description</span>
    @if (admin) { <div class="plan-actions"><a class="button primary" asp-action="Edit" asp-route-id="@plan.Id">Редактировать</a><a class="button" asp-action="Export" asp-route-id="@plan.Id">JSON ↓</a>
    <form asp-action="Duplicate" asp-route-id="@plan.Id" method="post"><input type="hidden" name="version" value="@plan.Version" /><button class="button" type="submit">Дублировать</button></form><a class="inline-link" asp-action="Delete" asp-route-id="@plan.Id">Удалить</a></div> }</div></section>
}
<p class="file-note">Демонстрационный аудит использует отдельную фиксированную выкладку. Проверка фотографии по выбранной планограмме появится на этапе интеграции детектора.</p>
