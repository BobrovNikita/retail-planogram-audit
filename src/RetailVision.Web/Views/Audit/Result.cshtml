@using RetailVision.Core
@model DemoViewModel
@{ ViewData["Title"] = "Результат аудита"; var c = Model.Compliance; }
<div class="page-heading"><div><p class="eyebrow">DEMO / @(Model.Scenario == "correct" ? "СЦЕНАРИЙ A" : Model.Scenario == "missing" ? "СЦЕНАРИЙ B" : "СЦЕНАРИЙ C")</p><h1>Результат аудита</h1><p class="subheading">Напитки · базовая выкладка / фиксированный снимок v1</p></div><a class="button secondary" href="/audit">← Другой сценарий</a></div>
<partial name="_DemoNotice" />
<div class="result-grid"><section class="panel result-visual"><div class="panel-heading"><h2>Учебная витрина</h2><span class="badge neutral">Иллюстрация · @Model.Detection.ModelVersion</span></div>
<svg class="audit-svg" viewBox="0 0 800 500" role="img" aria-label="Подготовленная иллюстрация с результатами проверки товаров">
    <rect x="0" y="0" width="800" height="500" rx="12" fill="#edf2ef" />
    <path d="M30 225H770M30 455H770" stroke="#c1cec6" stroke-width="12" />
    @foreach (var d in Model.Detection.Products)
    {
        var product = Model.Products[d.Sku!];
        var x = (int)(d.X * 800); var y = (int)(d.Y * 500); var w = (int)(d.Width * 800); var h = (int)(d.Height * 500);
        var status = c.MatchedDetectionIds.Contains(d.Id) ? "box-correct" : "box-warning";
        <g id="@d.Id" class="detection @status"><rect class="detection-box" x="@(x - 7)" y="@(y - 7)" width="@(w + 14)" height="@(h + 14)" rx="7" fill="none" stroke-width="3" /><rect x="@(x + 25)" y="@y" width="@(w - 50)" height="12" rx="3" fill="#bac8bf" /><rect x="@x" y="@(y + 12)" width="@w" height="@(h - 12)" rx="12" fill="@product.Color" /><rect x="@x" y="@(y + 57)" width="@w" height="55" fill="#f8f7ef" /><text x="@(x + w / 2)" y="@(y + 79)" text-anchor="middle" font-size="13" fill="#3c5748">RV STUDIO</text><text x="@(x + w / 2)" y="@(y + 99)" text-anchor="middle" font-size="12" fill="#3c5748">@product.Name.Split(' ')[0]</text><text x="@(x + w / 2)" y="@(y + h + 30)" text-anchor="middle" font-size="12" fill="#5d6e63">@d.Sku</text></g>
    }
</svg>
<div class="legend"><span><i class="legend-dot green"></i>Соответствует</span><span><i class="legend-dot yellow"></i>Неправильная позиция</span><span>Пропуски отмечены в эталоне ниже</span></div>
<h3>Ожидаемые позиции</h3><div class="expected-grid">@foreach (var e in Model.Expected) { var missing = c.Violations.Any(v => v.Kind == ViolationKind.MissingProduct && v.Shelf == e.Shelf && v.Position == e.Position); <div id="expected-@e.Shelf-@e.Position" class="expected-slot @(missing ? "missing-slot" : "")"><small>Полка @e.Shelf · @e.Position</small><strong>@Model.Products[e.Sku].Name</strong><span>@(missing ? "Не обнаружен" : e.Sku)</span></div> }</div>
</section><aside class="result-summary"><section class="panel score"><p class="eyebrow">СООТВЕТСТВИЕ ПО LCS</p><strong data-testid="compliance">@c.Percent.ToString("0.#")<span>%</span></strong><p>@c.Correct из @Math.Max(c.Expected, c.Detected) позиций сопоставлено</p><div class="score-details"><span>Обнаружено товаров <b>@c.Detected</b></span><span>Ожидается <b>@c.Expected</b></span><span>Нарушений / замечаний <b>@c.Violations.Count</b></span></div></section>
<section class="panel issues"><h2>Результаты сравнения</h2>@if (c.Violations.Count == 0) { <div class="success-message">✓ Все товары соответствуют эталону.</div> }
@foreach (var v in c.Violations)
{ var title = v.Kind switch { ViolationKind.MissingProduct => "Товар не обнаружен", ViolationKind.WrongPosition => "Неправильная позиция", ViolationKind.WrongShelf => "Неправильная полка", ViolationKind.UnknownProduct => "Требуется проверка", _ => "Лишний товар" }; var target = v.DetectionId ?? $"expected-{v.Shelf}-{v.Position}"; <button type="button" class="issue" data-highlight="@target"><strong>@title <span>↗</span></strong><span>@v.Sku · полка @v.Shelf</span><small>@(v.Position.HasValue ? $"Ожидаемая позиция {v.Position}" : "Вне эталона")</small></button> }</section>
<p class="method-note">Метрика: длина общей подпоследовательности по полкам / max(ожидаемых, обнаруженных) × 100%. Это учебная оценка сохранения порядка, а не универсальный отраслевой стандарт. При перестановке отмечается минимальное перемещение.</p></aside></div>
