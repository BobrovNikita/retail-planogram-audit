@model HistoryPage
@{ViewData["Title"]="История проверок"; var f=Model.Filter;}
<div class="page-heading"><div><p class="eyebrow">ПРОВЕРКИ / ИСТОРИЯ</p><h1>Каждая проверка — в истории</h1><p class="subheading">Ваши сохранённые результаты, исходные детекции и журнал исправлений.</p></div><a class="button primary" href="/photoaudit">Новая проверка →</a></div>
<p><a class="inline-link" href="/history/trash">Корзина и восстановление →</a></p>
<div asp-validation-summary="All" class="validation-errors"></div><partial name="_Filters" model="Model.Filter" />
<section class="panel"><div class="panel-heading"><h2>Сохранено: @Model.Total</h2><a class="inline-link" href="/history/analytics">Открыть аналитику →</a></div>
@if(Model.Total==0){<div class="table-empty"><div><h3>Проверок пока нет</h3><p>Сохраните результат анализа фото или учебный DEMO-сценарий. Если включены фильтры, попробуйте изменить условия.</p><a class="button secondary" href="/audit">Попробовать DEMO</a></div></div>}
else {<form action="/history/compare" method="get"><p class="file-note">Отметьте две проверки и сравните показатели. Даты указаны в UTC.</p><div class="table-scroll"><table class="audit-table"><thead><tr><th>Сравнить</th><th>Проверка</th><th>Дата UTC</th><th>Планограмма / зона</th><th>Режим</th><th>Соответствие</th><th>Отклонения / проверить</th><th>Редакция</th></tr></thead><tbody>
@foreach(var a in Model.Audits){<tr><td><input type="checkbox" name="ids" value="@a.Id" aria-label="Сравнить проверку @a.Id" /></td><td><a class="inline-link" href="/history/details/@a.Id">#@a.Id ↗</a></td><td>@a.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td><td><strong>@a.PlanogramName</strong><p class="file-note">@a.Store · версия @a.PlanogramVersion</p></td><td><span class="badge @(a.Mode=="REAL"?"mint":"amber")">@a.Mode</span></td><td><strong>@a.CompliancePercent.ToString("0.#")%</strong></td><td>@a.ConfirmedViolations / @a.ReviewCases</td><td>r@(a.Revision) <small>@(a.HasCorrections?"Есть ручные правки":"Исходный результат")</small></td></tr>}
</tbody></table></div><button class="button secondary" type="submit">Сравнить две проверки</button></form>
<nav class="history-pagination" aria-label="Страницы истории">@if(f.Page>1){<a class="inline-link" href="@Url.Action("Index",new {f.From,f.To,f.Mode,f.State,f.Search,Page=f.Page-1})">← Назад</a>}<span>Страница @f.Page · по 20 записей</span>@if(f.Page*20<Model.Total){<a class="inline-link" href="@Url.Action("Index",new {f.From,f.To,f.Mode,f.State,f.Search,Page=f.Page+1})">Далее →</a>}</nav>}
</section><p class="file-note">DEMO хранится отдельно от реальных результатов по метке режима. Фотографии и отчёты доступны только вам.</p>
