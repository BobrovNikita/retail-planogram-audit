@model AuditReport
@{ViewData["Title"]=$"Исправление #{Model.Audit.Id}";var a=Model.Audit;var s=Model.Snapshot;}
<div class="page-heading"><div><p class="eyebrow">ПРОВЕРКА #@a.Id / РЕДАКЦИЯ @a.Revision</p><h1>Проверьте каждый объект</h1><p class="subheading">@a.PlanogramName · @a.Mode · исходные детекции останутся в отчёте.</p></div><a class="button secondary" href="/history/details/@a.Id">← К отчёту</a></div>
<div class="notice"><span class="badge @(a.Mode=="DEMO"?"amber":"mint")">@a.Mode</span><p>Изменение SKU или рамки требует ручного подтверждения. Уверенность модели не меняется. Полка определяется автоматически по нижней точке рамки.</p></div>
<div id="review-editor" data-id="@a.Id" data-revision="@a.Revision" data-mode="@a.Mode">
<div class="saved-report-grid"><section class="panel review-canvas"><h2>@(a.PhotoPath is null?"Учебная иллюстрация":"Фотография")</h2><p class="file-note">Выберите объект в списке. Протяните новую рамку на изображении или задайте координаты числами.</p><svg id="review-canvas" viewBox="0 0 @s.Width @s.Height" role="img" aria-label="Редактируемые рамки объектов"><rect width="@s.Width" height="@s.Height" fill="#edf2ef" />@if(a.PhotoPath is not null){<image href="/history/image/@a.Id" width="@s.Width" height="@s.Height" />}<g id="review-background"></g><g id="review-boxes"></g></svg><p class="file-note">Изменения появятся в отчёте после сохранения и пересчёта.</p></section>
<section class="panel"><div class="panel-heading"><h2>Детекции</h2><button class="button secondary" type="button" id="add-detection" disabled>＋ Добавить</button></div><div id="review-objects" class="review-objects"></div></section></div>
<form id="review-form" class="panel matching-panel">@Html.AntiForgeryToken()<label>Причина изменения<textarea id="review-reason" required maxlength="1000" rows="2" placeholder="Например: уточнён SKU на верхней полке"></textarea></label><div class="report-actions"><button type="submit" class="button primary" id="save-review" disabled>Сохранить и пересчитать</button><button type="button" class="button secondary" id="restore-review" disabled>Восстановить исходные детекции</button></div><p id="review-status" role="status" aria-live="polite">Загрузка объектов…</p></form></div>
<script src="~/js/review.js" asp-append-version="true" defer></script>
