@model AuditReport
@{Layout=null;var a=Model.Audit;var c=Model.Result;}
<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>RetailVision · отчёт #@a.Id</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/history.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/print-report.css" asp-append-version="true" /><script src="~/js/history.js" asp-append-version="true" defer></script></head>
<body class="print-report"><main><div class="report-actions"><a class="button secondary" href="/history/details/@a.Id">← К отчёту</a><button class="button primary" type="button" data-print>Печать / сохранить PDF</button><span>В диалоге печати выберите «Сохранить как PDF».</span></div>
<header><p class="eyebrow">RETAILVISION / КОНТРОЛЬ ВЫКЛАДКИ</p><h1>Отчёт #@a.Id · редакция @a.Revision</h1><h2>@a.PlanogramName</h2><p>@a.Store · @a.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC · эталон v@(a.PlanogramVersion)</p><p><strong>@a.Mode · @(a.Mode=="DEMO"?"Демонстрационные данные — нейросеть не использовалась":"Результат модели; точность отдельно не подтверждена")</strong></p><p>Модель: @a.ModelName · @(a.HasCorrections?"Есть ручные правки":"Без ручных правок")</p></header>
<table class="audit-table print-metrics"><thead><tr><th>Соответствие</th><th>Исходное</th><th>LCS</th><th>Наличие SKU</th><th>Фейсинги</th><th>Отклонения / проверить</th></tr></thead><tbody><tr><td>@c.Percent.ToString("0.#")%</td><td>@a.OriginalPercent.ToString("0.#")%</td><td>@c.Metrics.SequencePercent.ToString("0.#")%</td><td>@c.Metrics.SkuPresencePercent.ToString("0.#")%</td><td>@c.Metrics.FacingsPercent.ToString("0.#")%</td><td>@c.Metrics.ConfirmedViolations / @c.Metrics.ReviewCases</td></tr></tbody></table>
<partial name="_Report" model="Model" />
<section class="panel matching-panel"><h2>Журнал исправлений</h2>@if(a.Corrections.Count==0){<p>Исправлений нет.</p>}else{<ol>@foreach(var change in a.Corrections.OrderBy(x=>x.Revision)){<li>r@(change.Revision) · @change.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC · владелец проверки<p>@change.Reason</p></li>}</ol>}</section>
<footer><p>Порог подтверждения: @Model.Snapshot.ConfidenceThreshold.ToString("P0"). Ручное подтверждение не меняет исходную уверенность модели. «Не обнаружен» не доказывает отсутствие товара.</p><p>SHA-256 модели: @(a.ModelSha256??"не применяется для DEMO"). Полные исходные данные и журнал до/после доступны в JSON-экспорте.</p></footer></main></body></html>
