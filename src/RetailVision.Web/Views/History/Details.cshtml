@using RetailVision.Core
@model AuditReport
@{ViewData["Title"]=$"Проверка #{Model.Audit.Id}";var a=Model.Audit;var s=Model.Snapshot;var c=Model.Result;}
<div class="page-heading"><div><p class="eyebrow">ИСТОРИЯ / #@a.Id / РЕДАКЦИЯ @a.Revision</p><h1>@a.PlanogramName</h1><p class="subheading">@a.Store · @a.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC · эталон v@(a.PlanogramVersion)</p></div><div class="report-actions"><a class="button secondary" href="/history">← История</a><a class="button secondary" href="/history/export/@a.Id">Скачать JSON</a><a class="button secondary" href="/history/print/@a.Id">Печать / PDF</a>@if(a.ArchivedAtUtc is null){<a class="button primary" href="/history/edit/@a.Id">Исправить детекции</a>}</div></div>
@if(a.ArchivedAtUtc is not null){<div class="notice"><span class="badge amber">В КОРЗИНЕ</span><p>Этот отчёт исключён из аналитики. <a href="/history/trash">Восстановить или проверить срок хранения →</a></p></div>}
<div class="notice"><span class="badge @(a.Mode=="REAL"?"mint":"amber")">@a.Mode</span><div><strong>@(a.Mode=="DEMO"?"Демонстрационные данные — нейросеть не использовалась":"Результат модели; точность требует независимой проверки")</strong><p>@a.ModelName @(s.Scenario is null?"":$"· сценарий {s.Scenario}") · @(a.HasCorrections?"Есть ручные исправления, исходный результат сохранён":"Исходный результат без ручных правок")</p></div></div>
<section class="metrics"><article class="metric"><span>Соответствие сейчас</span><strong>@c.Percent.ToString("0.#")%</strong><small>Исходное: @a.OriginalPercent.ToString("0.#")%</small></article><article class="metric"><span>Наличие SKU</span><strong>@c.Metrics.SkuPresencePercent.ToString("0.#")%</strong><small>Фейсинги: @c.Metrics.FacingsPercent.ToString("0.#")%</small></article><article class="metric"><span>Порядок LCS</span><strong>@c.Metrics.SequencePercent.ToString("0.#")%</strong><small>@c.Correct из @c.Expected позиций</small></article><article class="metric"><span>Отклонения / проверить</span><strong>@c.Metrics.ConfirmedViolations / @c.Metrics.ReviewCases</strong><small>Объектов: @c.Detected</small></article></section>
<partial name="_Report" model="Model" />
<section class="panel matching-panel"><h2>Журнал исправлений</h2>
@if(a.Corrections.Count==0){<p class="file-note">Исправлений пока нет. Исходные детекции остаются неизменными.</p>}
else{<ol class="correction-log">@foreach(var change in a.Corrections.OrderByDescending(x=>x.Revision)){<li><strong>Редакция @change.Revision · @change.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</strong><p>@change.Reason</p><small>Автор: владелец проверки · полное состояние до и после доступно в JSON.</small></li>}</ol>}
</section><details class="panel matching-panel"><summary>Модель и методика</summary><p class="file-note">@a.ModelName · SHA-256: @(a.ModelSha256??"не применяется для DEMO")</p><p>Порог: @s.ConfidenceThreshold.ToString("P0"). Полки определяются по нижней опорной точке. Ручное подтверждение — решение человека, а не новая уверенность модели. Пропуск означает отсутствие подтверждённой детекции. @(c.UsesPositionGeometry?"Проверяется геометрия ожидаемых позиций.":"Абсолютные позиции не заданы; сравниваются полка, порядок и количество.")</p><a href="/history/export/@a.Id">Исходные и исправленные данные в JSON</a></details>
@if(a.ArchivedAtUtc is null){<section class="panel"><h2>Хранение проверки</h2><p>Перемещение в корзину исключит проверку из аналитики. Фотография и журнал сохранятся; отчёт можно восстановить.</p><form asp-action="Archive" asp-route-id="@a.Id" method="post"><input type="hidden" name="revision" value="@a.Revision" /><button type="submit" class="button secondary">В корзину</button></form></section>}
<script src="~/js/history.js" asp-append-version="true" defer></script>
