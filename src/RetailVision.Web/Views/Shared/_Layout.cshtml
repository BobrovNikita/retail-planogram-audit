@{
    var current = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var nav = new[] { ("/", "◫", "Дашборд"), ("/audit", "⌗", "Аудит витрины"), ("/planograms", "▤", "Планограммы"), ("/catalog", "▦", "Каталог товаров"), ("/home/history", "◷", "История проверок"), ("/home/analytics", "↗", "Аналитика"), ("/home/settings", "⚙", "Настройки") };
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RetailVision — контроль выкладки товаров и соответствия планограммам." />
    <title>@ViewData["Title"] · RetailVision</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editor.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Перейти к содержимому</a>
<aside class="sidebar">
    <a class="brand" href="/"><span class="brand-icon">▥</span>Retail<span>Vision</span></a>
    <div class="workspace"><span class="workspace-icon">RV</span><div>Учебное пространство<small>Planogram compliance</small></div><span class="workspace-dot"></span></div>
    <p class="nav-label">РАБОЧЕЕ ПРОСТРАНСТВО</p>
    <nav aria-label="Основная навигация">
    @foreach (var (url, icon, label) in nav)
    {
        var active = url == "/" ? current == "/" || current == "/home" || current == "/home/index" : current.StartsWith(url);
        <a href="@url" class="nav-item @(active ? "active" : "")" aria-current="@(active ? "page" : null)"><span aria-hidden="true">@icon</span>@label</a>
    }
    </nav>
    <div class="sidebar-bottom"><span class="badge outline">ЭТАП 02 / 06</span><h3>От полки к данным</h3><p>Каталог и редактор готовы. Создайте эталон выкладки или изучите учебные сценарии.</p><a href="/audit">Открыть демонстрацию <span>↗</span></a></div>
    <div class="sidebar-footer"><span class="avatar">RV</span><div>RetailVision<small>Версия 0.2 · DEMO</small></div></div>
</aside>
<div class="app-shell">
    <header class="topbar"><span>Рабочее пространство <span class="breadcrumb-slash">/</span> <strong>@ViewData["Title"]</strong></span><div class="topbar-right"><span class="status-dot"></span><span>Учебная версия</span>
    @if (User.Identity?.IsAuthenticated == true)
    { <form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button" type="submit">Выйти</button></form> }
    else
    { <a class="login-link" href="/account/login">Вход администратора ↗</a> }
    </div></header>
    <main id="main">@if (TempData["Notice"] is string notice) { <div class="success-message flash" role="status">@notice</div> }@RenderBody()</main>
    <footer class="page-footer"><span>RetailVision / Контроль выкладки</span><span>Прозрачные данные. Понятные решения.</span></footer>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
