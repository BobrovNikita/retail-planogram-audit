@model LoginViewModel
@{ ViewData["Title"] = "Вход администратора"; }
<section class="panel login-panel"><span class="badge mint">АДМИНИСТРИРОВАНИЕ</span><h1>Добро пожаловать</h1><p class="subheading">Войдите для доступа к защищённым разделам.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation-errors" role="alert"></div><input type="hidden" asp-for="ReturnUrl" /><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="username" /><label asp-for="Password">Пароль</label><input asp-for="Password" autocomplete="current-password" /><button class="button primary" type="submit">Войти →</button></form><p class="method-note">Публичного пароля нет. Учётную запись создаёт владелец через переменные окружения при первом запуске. Для DEMO вход не нужен.</p><a class="inline-link" href="/audit">Открыть публичный DEMO →</a></section>
