server_tokens off;
client_max_body_size 10m;
client_body_timeout 30s;
send_timeout 60s;

server {
    listen 8080 default_server;
    server_name ${DOMAIN};
    if ($host != "${DOMAIN}") { return 444; }
    return 308 https://${DOMAIN}:${HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl default_server;
    server_name ${DOMAIN};
    if ($host != "${DOMAIN}") { return 444; }
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    location / {
        # Docker DNS is re-resolved when app is recreated during updates/restores.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $application http://app:8080;
        proxy_pass $application;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        # A single edge proxy: overwrite client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache off;
    }
}
